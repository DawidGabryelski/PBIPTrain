table Date
	lineageTag: 9426bc47-beff-4102-b6d8-ee6e2fc81ab7
	dataCategory: Time

	measure _ShowValueForDates =
			
			VAR __LastDateWithData =
			    CALCULATE (
			        MAXX ( { MAX ( 'FactSales'[OrderDate] ), MAX ( 'FactSales'[ShipDate] ), MAX ( 'DimDate'[Date] ) }, ''[Value] ),
			        REMOVEFILTERS ()
			    )
			VAR __FirstDateVisible =
			    MIN ( 'Date'[Date] )
			VAR __Result =
			    __FirstDateVisible <= __LastDateWithData
			RETURN
			    __Result
		isHidden
		displayFolder: Hidden Time Intelligence
		lineageTag: dc8b9d38-4b84-4c93-8df3-0bb8b9e64ae6

