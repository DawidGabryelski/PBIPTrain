		level Date
			lineageTag: 4894852c-3806-4dd0-9086-7e22871c61d2
			column: Date

	partition TimeInteligence = calculated
		mode: import
		source = ```
				
				--  
				--     Configuration
				--  
				VAR __FirstDayOfWeek = 1
				----------------------------------------
				VAR __WeekDayCalculationType = IF ( __FirstDayOfWeek = 0, 7, __FirstDayOfWeek ) + 10
				VAR __Calendar = 
				    VAR __FirstYear = YEAR ( MINX ( { MIN ( 'FactSales'[OrderDate] ), MIN ( 'FactSales'[ShipDate] ), MIN ( 'DimDate'[Date] ) }, ''[Value] ) )
				    VAR __LastYear =  YEAR ( MAXX ( { MAX ( 'FactSales'[OrderDate] ), MAX ( 'FactSales'[ShipDate] ), MAX ( 'DimDate'[Date] ) }, ''[Value] ) )
				    RETURN CALENDAR (
				        DATE ( __FirstYear, 1, 1 ),
				        DATE ( __LastYear, 12, 31 )
				    )
				VAR __Step3 = 
				    GENERATE (
				        __Calendar,
				        VAR __IsStandardLocale = IF ( FORMAT( DATE( 2000, 1, 1 ), "oooo", "en-GB" ) = "oooo", TRUE, FALSE )
				        VAR __MonthFormatString = IF( __IsStandardLocale, "mmm", "ooo" )
				        VAR __DayFormatString = IF( __IsStandardLocale, "ddd", "aaa" )
				        VAR __LastTransactionDate = MAXX ( { MAX ( 'FactSales'[OrderDate] ), MAX ( 'FactSales'[ShipDate] ), MAX ( 'DimDate'[Date] ) }, ''[Value] )
				        VAR __Date = [Date]
				        VAR __YearNumber = YEAR ( __Date )
				        VAR __QuarterNumber = QUARTER ( __Date )
				        VAR __YearQuarterNumber = CONVERT ( __YearNumber * 4 + __QuarterNumber - 1, INTEGER )
				        VAR __MonthNumber = MONTH ( __Date )
				        VAR __WeekDayNumber = WEEKDAY ( __Date, __WeekDayCalculationType )
				        VAR __WeekDay = FORMAT ( __Date, __DayFormatString, "en-GB" )
				        RETURN ROW ( 
				            "Year", __YearNumber,
				            "Year Quarter Number", __YearQuarterNumber,
				            "Year Quarter", FORMAT ( __QuarterNumber, "\Q0", "en-GB" ) & "-" & FORMAT ( __YearNumber, "0000", "en-GB" ),
				            "Quarter", FORMAT( __QuarterNumber, "\Q0", "en-GB" ),
				            "Year Month", FORMAT ( __Date, __MonthFormatString & " yyyy", "en-GB" ),
				            "Year Month Number", __YearNumber * 12 + __MonthNumber - 1,
				            "Month", FORMAT ( __Date, __MonthFormatString, "en-GB" ),
				            "Month Number", __MonthNumber,
				            "Day of Week Number", __WeekDayNumber,
				            "Day of Week", __WeekDay,
				            "DateWithTransactions", __Date <= __LastTransactionDate 
				        )
				    )
				RETURN
				    __Step3
				```

	annotation SQLBI_Template = Dates

	annotation SQLBI_TemplateTable = DateAutoTemplate

	annotation SQLBI_CalendarType = Calendar

